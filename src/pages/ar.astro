---
import '@fontsource/jetbrains-mono/latin-ext.css';
import Logo from '../components/Logo.astro';
import Base from '../layouts/Base.astro';
import { email } from '../data/site';

// The card's QR opens this page. Instead of fragile live image-tracking (or a
// native-AR handoff that can't animate on iOS), it shows the JK monogram as an
// interactive 3D object that rises off the "paper" and catches a vermilion light
// as you tilt the phone. Pure WebGL — zero camera, zero install, ~100% on iOS +
// Android. Strings resolve client-side from navigator.language. noindex; always ink.
---

<Base lang="en" noindex>
  <main id="main-content" class="ar">
    <header class="ar__head">
      <span class="label-mono ar__kicker">Josef Kvapil</span>
      <span class="label-mono ar__role" id="ar-role"></span>
    </header>

    <div class="ar__stage" id="ar-stage">
      {/* the finale: the bars reassemble into this working button (mailto) */}
      <a class="ar__cta label-mono" id="ar-cta" href={`mailto:${email}`} data-ev="cta_mail" hidden></a>
      {/* maker's signature — fades in the first time the scattered mark reassembles */}
      <p class="ar__sig" id="ar-sig" aria-hidden="true">Josef Kvapil</p>
      <div class="ar__fallback" id="ar-fallback" hidden>
        <Logo class="ar__fallback-mark" />
      </div>
    </div>

    <p class="ar__hint label-mono" id="ar-hint"></p>

    <div class="ar__actions">
      <a href="/josef.vcf" download class="ar__btn" id="ar-save" data-ev="contact_save"></a>
      <a href={`mailto:${email}`} class="ar__btn ar__btn--ghost" id="ar-mail" data-ev="cta_mail"></a>
      <a href="/" class="ar__btn ar__btn--ghost" id="ar-web" data-ev="cta_web"></a>
    </div>

    <div id="ar-toast" class="ar__toast label-mono" role="status" hidden></div>
  </main>
</Base>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }
  .ar {
    /* always ink — global tokens flip in dark theme */
    --ink: #121110;
    --paper: #e8e4dc;
    --muted: #918c84;
    --accent: #ff5a3c;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    padding: max(1.25rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(1.25rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
    box-sizing: border-box;
  }
  .ar__head {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .ar__kicker {
    color: var(--accent);
    font-size: 0.8rem;
  }
  .ar__role {
    color: var(--muted);
    font-size: 0.7rem;
  }
  .ar__stage {
    position: relative;
    flex: 1;
    min-height: 0;
    width: 100%;
    touch-action: none;
  }
  .ar__stage :global(canvas) {
    display: block;
  }
  /* the finale CTA sits exactly over the 3D slab (world origin → stage centre);
     the slab is the visual, this anchor is the label + the click */
  .ar__cta {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
    color: var(--ink);
    font-size: 0.95rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 2.5rem;
    white-space: nowrap;
  }
  /* the label stamps onto the freshly forged button */
  @keyframes ar-stamp {
    from {
      transform: translate(-50%, -50%) scale(1.7);
      opacity: 0;
    }
    to {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
  }
  .ar__cta.is-stamped {
    animation: ar-stamp 0.45s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .ar__cta.is-stamped {
      animation: none;
    }
  }
  .ar__sig {
    position: absolute;
    left: 50%;
    bottom: 4%;
    transform: translateX(-50%);
    margin: 0;
    font-family: 'Instrument Serif', Georgia, serif;
    font-style: italic;
    font-size: 1.35rem;
    color: var(--paper);
    opacity: 0;
    transition: opacity 1.4s ease;
    pointer-events: none;
  }
  .ar__sig.is-signed {
    opacity: 0.85;
  }
  .ar__fallback {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ar__fallback-mark {
    width: 40%;
    max-width: 9rem;
    height: auto;
    color: var(--paper);
  }
  /* left-aligned with the lockup — one Swiss column, the action row is the
     sole centered exception */
  .ar__hint {
    text-align: left;
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.9rem;
  }
  .ar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .ar__btn {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    background: var(--accent);
    border: none;
    padding: 0.7rem 1.3rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
  }
  .ar__btn:hover {
    opacity: 0.92;
  }
  @keyframes ar-nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    35% {
      transform: translateY(-3px);
    }
  }
  .ar__btn.is-nudged {
    animation: ar-nudge 0.6s ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .ar__btn.is-nudged {
      animation: none;
    }
  }
  .ar__btn--ghost {
    background: transparent;
    color: var(--paper);
    /* 60% so the outline clears the 3:1 WCAG UI-component contrast floor */
    border: 1px solid color-mix(in srgb, var(--paper) 60%, transparent);
  }
  .ar__toast {
    position: absolute;
    left: 50%;
    top: max(1.2rem, env(safe-area-inset-top));
    transform: translateX(-50%);
    z-index: 4;
    background: var(--accent);
    color: var(--ink);
    padding: 0.5rem 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

<script>
  import { email } from '../data/site';
  import { ui, type Lang } from '../i18n/ui';
  import { start } from '../scripts/ar';

  const byId = (id: string) => {
    const el = document.getElementById(id);
    if (!el) throw new Error(`#${id} missing`);
    return el;
  };

  const lang: Lang = navigator.language?.toLowerCase().startsWith('cs') ? 'cs' : 'en';
  const t = ui[lang];
  document.documentElement.lang = lang;

  const stage = byId('ar-stage');
  const fallback = byId('ar-fallback');
  const toast = byId('ar-toast');
  const cta = byId('ar-cta');

  byId('ar-role').textContent = t['ar.role'];
  byId('ar-hint').textContent = t['ar.hint'];
  byId('ar-save').textContent = t['ar.save'];
  byId('ar-mail').textContent = t['ar.mail'];
  byId('ar-web').textContent = t['ar.web'];
  cta.textContent = `${t['story.btnReal']} →`;
  toast.textContent = t['ar.toast'];

  // the hint line narrates the toy: throw → "it snaps back" → invite the
  // double-tap → after the full scatter reassembles, the punchline + signature
  const hint = byId('ar-hint');
  const sig = byId('ar-sig');
  const saveBtn = byId('ar-save');
  let scattered = false;
  let signed = false;
  let sceneMode = 'mark';
  let scatters = 0;
  const handle = start(stage, {
    label: t['ar.alt'],
    onScatter: (count) => {
      scattered = true;
      scatters = count;
      cta.hidden = true; // in flight — the label waits for the slab to seat
    },
    onAccentThrow: () => {
      if (sceneMode === 'mark') hint.textContent = t['ar.hintAccent'];
    },
    onRage: () => {
      hint.textContent = t['ar.hintRage'];
    },
    onMode: (mode) => {
      sceneMode = mode;
      if (mode === 'button') {
        hint.textContent = t['ar.finale'];
        cta.hidden = false; // the bars just became a working button
        cta.classList.remove('is-stamped');
        requestAnimationFrame(() => cta.classList.add('is-stamped'));
      }
    },
    onSettle: (attempts, allHome) => {
      if (sceneMode === 'button') return; // the finale owns the copy
      if (scattered && allHome) {
        scattered = false;
        // count up toward the finale — telegraphs there's a payoff at ten
        hint.textContent =
          scatters > 1
            ? t['ar.standing'].replace('{n}', String(Math.min(scatters, 9)))
            : t['ar.hint4'];
        saveBtn.classList.remove('is-nudged');
        requestAnimationFrame(() => saveBtn.classList.add('is-nudged'));
        if (!signed) {
          signed = true;
          sig.classList.add('is-signed'); // the maker signs the reassembled mark
          console.log(
            `%c${attempts} attempt${attempts === 1 ? '' : 's'} to break it. Still standing.\nI build software the same way. → ${email}`,
            'font-family:ui-monospace,monospace;color:#ff5a3c',
          );
        }
      } else if (attempts >= 5) {
        hint.textContent = t['ar.hintN'].replace('{n}', String(attempts));
      } else if (attempts >= 2) {
        hint.textContent = t['ar.hint3'];
      } else {
        hint.textContent = t['ar.hint2'];
      }
    },
  });
  if (!handle) {
    // no WebGL — show the static mark, keep the working contact buttons
    fallback.hidden = false;
    fallback.setAttribute('role', 'img');
    fallback.setAttribute('aria-label', t['ar.alt']);
  } else {
    // gyro is a free enhancement where no permission is needed (Android);
    // on iOS we skip the permission nag — mouse/idle lean covers the light
    addEventListener('pagehide', () => handle.stop(), { once: true });
    // bfcache back-navigation would restore a stopped canvas — start fresh
    addEventListener('pageshow', (e) => {
      if (e.persisted) location.reload();
    });
  }

  // analytics + save-contact toast (unchanged event hooks)
  const track = (name: string) =>
    dispatchEvent(new CustomEvent('ar:event', { detail: { name } }));
  let toastTimer = 0;
  for (const el of document.querySelectorAll<HTMLElement>('[data-ev]')) {
    el.addEventListener('click', () => {
      track(el.dataset.ev ?? '');
      if (el.dataset.ev === 'contact_save') {
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => (toast.hidden = true), 2200);
      }
    });
  }
</script>
