---
import Base from '../layouts/Base.astro';
import { email } from '../data/site';

// The card's QR opens this page. Instead of fragile live image-tracking, it
// shows the JK monogram as an interactive 3D object (model-viewer) that works
// on every device/browser with zero camera permission, and offers NATIVE AR
// ("view in your space") via Quick Look (iOS) / Scene Viewer (Android) — rock
// steady, ARKit/ARCore quality. noindex; always-ink regardless of theme.
---

<Base lang="en" noindex>
  <main id="main-content" class="ar">
    <header class="ar__head">
      <span class="label-mono ar__kicker">Josef Kvapil</span>
      <span class="label-mono ar__role">Frontend architekt · Liberec</span>
    </header>

    <model-viewer
      id="ar-mv"
      src="/ar/model.glb"
      ios-src="/ar/model.usdz"
      alt="3D monogram Josefa Kvapila"
      poster="/favicon.svg"
      camera-controls
      auto-rotate
      auto-rotate-delay="600"
      rotation-per-second="18deg"
      interaction-prompt="none"
      shadow-intensity="1.2"
      shadow-softness="1"
      environment-image="neutral"
      exposure="1.15"
      camera-orbit="18deg 78deg auto"
      min-camera-orbit="auto 60deg auto"
      max-camera-orbit="auto 95deg auto"
      ar
      ar-modes="webxr scene-viewer quick-look"
      ar-scale="fixed"
    >
      <button id="ar-btn" slot="ar-button" class="ar__btn ar__ar">Postav do prostoru · AR →</button>
      <div slot="progress-bar" class="ar__progress"><div class="ar__progress-fill"></div></div>
    </model-viewer>

    <p class="ar__hint label-mono">Táhni pro otočení · AR postaví monogram do prostoru</p>

    <div class="ar__actions">
      <a href="/josef.vcf" download class="ar__btn" data-ev="contact_save">Uložit kontakt</a>
      <a href={`mailto:${email}`} class="ar__btn ar__btn--ghost" data-ev="cta_mail">Napiš mi</a>
      <a href="/" class="ar__btn ar__btn--ghost" data-ev="cta_web">jkvapil.cz</a>
    </div>

    <div id="ar-toast" class="ar__toast label-mono" role="status" hidden>Kontakt stažen ✓</div>
  </main>
</Base>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }
  .ar {
    /* always ink — global tokens flip in dark theme */
    --ink: #121110;
    --paper: #e8e4dc;
    --muted: #918c84;
    --accent: #ff5a3c;
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background: var(--ink);
    color: var(--paper);
    display: flex;
    flex-direction: column;
    padding: max(1.25rem, env(safe-area-inset-top)) max(1.25rem, env(safe-area-inset-right))
      max(1.25rem, env(safe-area-inset-bottom)) max(1.25rem, env(safe-area-inset-left));
    box-sizing: border-box;
  }
  .ar__head {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .ar__kicker {
    color: var(--accent);
    font-size: 0.8rem;
  }
  .ar__role {
    color: var(--muted);
    font-size: 0.7rem;
  }
  #ar-mv {
    flex: 1;
    width: 100%;
    min-height: 0;
    background: transparent;
    --poster-color: transparent;
    --progress-bar-color: var(--accent);
  }
  .ar__hint {
    text-align: center;
    color: var(--muted);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 0.9rem;
  }
  .ar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }
  .ar__btn {
    font-family: var(--font-mono, 'JetBrains Mono', monospace);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper);
    background: var(--accent);
    border: none;
    padding: 0.7rem 1.3rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
  }
  .ar__btn:hover {
    opacity: 0.92;
  }
  .ar__btn--ghost {
    background: transparent;
    color: var(--paper);
    border: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
  }
  /* the AR launch button floats over the viewer, bottom-centre */
  .ar__ar {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
  }
  .ar__progress {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40%;
    max-width: 12rem;
    height: 2px;
    transform: translate(-50%, -50%);
    background: color-mix(in srgb, var(--paper) 20%, transparent);
  }
  .ar__progress-fill {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.2s;
  }
  .ar__toast {
    position: absolute;
    left: 50%;
    top: max(1.2rem, env(safe-area-inset-top));
    transform: translateX(-50%);
    z-index: 4;
    background: var(--accent);
    color: var(--paper);
    padding: 0.5rem 0.9rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>

<script>
  import '@google/model-viewer';

  const mv = document.getElementById('ar-mv') as HTMLElement & {
    canActivateAR?: boolean;
  };
  const arBtn = document.getElementById('ar-btn')!;
  const toast = document.getElementById('ar-toast')!;

  // hide the AR button where native AR isn't available (desktop, some webviews)
  const syncAr = () => {
    arBtn.hidden = !mv?.canActivateAR;
  };
  mv?.addEventListener('load', syncAr);
  mv?.addEventListener('ar-status', syncAr);
  setTimeout(syncAr, 1200);

  // drive the loading progress bar
  const fill = mv?.querySelector('.ar__progress-fill') as HTMLElement | null;
  const bar = mv?.querySelector('.ar__progress') as HTMLElement | null;
  mv?.addEventListener('progress', (e) => {
    const p = (e as CustomEvent<{ totalProgress: number }>).detail.totalProgress;
    if (fill) fill.style.width = `${p * 100}%`;
    if (bar) bar.hidden = p >= 1;
  });

  const track = (name: string) =>
    dispatchEvent(new CustomEvent('ar:event', { detail: { name } }));
  let toastTimer = 0;
  for (const el of document.querySelectorAll<HTMLElement>('[data-ev]')) {
    el.addEventListener('click', () => {
      track(el.dataset.ev!);
      if (el.dataset.ev === 'contact_save') {
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => (toast.hidden = true), 2200);
      }
    });
  }
</script>
